{
  "name": "@nuxt-layers/theme-manager",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Nuxt foundation capability for semantic presentation theme definition, resolution and management.",
  "exports": {
    ".": "./nuxt.config.ts",
    "./contracts": "./contracts/index.ts",
    "./capability": "./capability.json",
    "./presentation.css": "./assets/css/main.css"
  },
  "files": [
    "app",
    "server",
    "shared",
    "contracts",
    "capability.json",
    "nuxt.config.ts",
    "README.md",
    "assets",
    "public"
  ],
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm check:theme",
    "check:theme": "node scripts/generate-theme-api.mjs --check",
    "generate:theme": "node scripts/generate-theme-api.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "nuxt": "^4.6.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.5"
  }
}
